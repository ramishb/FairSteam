  <http://www.w3.org/2000/01/rdf-schema#label> "Steam Store Games – top 1000 (FAIRified)";
  dcterms:title "Steam Store Games – top 1000 (FAIRified)";
  dcterms:hasVersion "1.0";
  <https://w3id.org/fdp/fdp-o#metadataIssued> "2026-10-06T07:56:25.677902207Z"^^xsd:dateTime;
