@prefix : <https://w3id.org/FAIR-course-UT/2026/group02/ont#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/FAIR-course-UT/2026/group02/ont#> .

<https://w3id.org/FAIR-course-UT/2026/group02/ont> rdf:type owl:Ontology ;
                                                         dcterms:creator "Ramish Bhutto" ;
                                                         dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                                         rdfs:comment "Mini-ontology for the FAIRified Steam Store Games dataset. It defines the Steam-specific terms (Steam game, store labels, rating counts) and reuses schema.org and Wikidata for everything else."@en ;
                                                         rdfs:label "Steam games ontology"@en ;
                                                         owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://schema.org/gamePlatform
schema:gamePlatform rdf:type owl:ObjectProperty .


###  http://schema.org/genre
schema:genre rdf:type owl:ObjectProperty .


###  http://schema.org/offers
schema:offers rdf:type owl:ObjectProperty .


###  http://schema.org/publisher
schema:publisher rdf:type owl:ObjectProperty .


###  http://www.wikidata.org/prop/direct/P178
wdt:P178 rdf:type owl:ObjectProperty ;
         rdfs:label "Game Developer"@en .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#storeLabel
:storeLabel rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf schema:genre ;
            rdfs:domain :SteamGame ;
            rdfs:range :SteamStoreLabel ;
            rdfs:comment "Steam store specific tag"@en ;
            rdfs:label "Store Label"@en .


#################################################################
#    Data properties
#################################################################

###  http://schema.org/datePublished
schema:datePublished rdf:type owl:DatatypeProperty ;
                     rdfs:label "Release Date"@en .


###  http://schema.org/name
schema:name rdf:type owl:DatatypeProperty ;
            rdfs:label "Game Title"@en .


###  http://schema.org/price
schema:price rdf:type owl:DatatypeProperty ;
             rdfs:label "Price"@en .


###  http://schema.org/priceCurrency
schema:priceCurrency rdf:type owl:DatatypeProperty ;
                     rdfs:label "Price Currency"@en .


###  http://www.wikidata.org/prop/direct/P1733
wdt:P1733 rdf:type owl:DatatypeProperty ;
          rdfs:label "Steam app ID"@en .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#negativeRatings
:negativeRatings rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :userRatingCount ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain :SteamGame ;
                 rdfs:range xsd:nonNegativeInteger ;
                 rdfs:comment "Number of Steam user reviews that do not recommend the game, collected around May 2019."@en ;
                 rdfs:label "negative ratings"@en .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#positiveRatings
:positiveRatings rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :userRatingCount ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain :SteamGame ;
                 rdfs:range xsd:nonNegativeInteger ;
                 rdfs:comment "Number of Steam user reviews that recommend the game, collected around May 2019."@en ;
                 rdfs:label "positive ratings"@en .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#userRatingCount
:userRatingCount rdf:type owl:DatatypeProperty ;
                 rdfs:domain :SteamGame ;
                 rdfs:range xsd:nonNegativeInteger ;
                 rdfs:comment "Number of Steam user reviews, collected in 2019."@en ;
                 rdfs:label "User Rating Count"@en .


#################################################################
#    Classes
#################################################################

###  http://schema.org/Offer
schema:Offer rdf:type owl:Class .


###  http://schema.org/Organization
schema:Organization rdf:type owl:Class .


###  http://schema.org/VideoGame
schema:VideoGame rdf:type owl:Class .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#SteamGame
:SteamGame rdf:type owl:Class ;
           rdfs:subClassOf schema:VideoGame ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty schema:publisher ;
                             owl:someValuesFrom schema:Organization
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty wdt:P178 ;
                             owl:someValuesFrom schema:Organization
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty schema:gamePlatform ;
                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty schema:genre ;
                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty schema:offers ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass schema:Offer
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty schema:datePublished ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty schema:name ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty wdt:P1733 ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :negativeRatings ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :positiveRatings ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:nonNegativeInteger
                           ] ;
           rdfs:label "Steam game"@en .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#SteamStoreLabel
:SteamStoreLabel rdf:type owl:Class ;
                 rdfs:label "Steam Store Label"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/FAIR-course-UT/2026/group02/ont#EarlyAccess
:EarlyAccess rdf:type owl:NamedIndividual ,
                      :SteamStoreLabel ;
             rdfs:comment "Steam store label for development status, not a gameplay genre."@en ;
             rdfs:label "Early Access"@en ;
             rdfs:seeAlso <http://www.wikidata.org/entity/Q17042291> .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#FreetoPlay
:FreetoPlay rdf:type owl:NamedIndividual ,
                     :SteamStoreLabel ;
            rdfs:comment "Steam store label for business model, not a gameplay genre."@en ;
            rdfs:label "Free to Play"@en ;
            rdfs:seeAlso <http://www.wikidata.org/entity/Q1414510> .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#Gore
:Gore rdf:type owl:NamedIndividual ,
               :SteamStoreLabel ;
      rdfs:comment "Steam content descriptor, not a gameplay genre."@en ;
      rdfs:label "Gore"@en ;
      rdfs:seeAlso <http://www.wikidata.org/entity/Q60316461> .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#Indie
:Indie rdf:type owl:NamedIndividual ,
                :SteamStoreLabel ;
       rdfs:comment "Steam store label for games by independent developers, not a gameplay genre."@en ;
       rdfs:label "Indie"@en ;
       rdfs:seeAlso <http://www.wikidata.org/entity/Q2762504> .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#Nudity
:Nudity rdf:type owl:NamedIndividual ,
                 :SteamStoreLabel ;
        rdfs:comment "Steam content descriptor, not a gameplay genre."@en ;
        rdfs:label "Nudity"@en ;
        rdfs:seeAlso <http://www.wikidata.org/entity/Q60324383> .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#SexualContent
:SexualContent rdf:type owl:NamedIndividual ,
                        :SteamStoreLabel ;
               rdfs:comment "Steam content descriptor, not a gameplay genre."@en ;
               rdfs:label "Sexual Content"@en .


###  https://w3id.org/FAIR-course-UT/2026/group02/ont#Violent
:Violent rdf:type owl:NamedIndividual ,
                  :SteamStoreLabel ;
         rdfs:comment "Steam content descriptor, not a gameplay genre."@en ;
         rdfs:label "Violent"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :EarlyAccess
                        :FreetoPlay
                        :Gore
                        :Indie
                        :Nudity
                        :SexualContent
                        :Violent
                      )
] .


